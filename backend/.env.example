# TrustRelay backend configuration. Copy to .env for local development. NEVER commit real values.
TR_ENVIRONMENT=development
TR_DATABASE_URL=postgresql+asyncpg://trustrelay:trustrelay@localhost:5432/trustrelay
# Leave empty in development to use the in-memory rate limiter and inline analysis.
TR_REDIS_URL=
TR_ANALYSIS_INLINE=true

# Secrets: generate with `python -c "import secrets;print(secrets.token_urlsafe(48))"`
TR_JWT_SECRET=
# Comma-separated keyid:base64(32 bytes). First key encrypts, all keys decrypt.
# Generate: python -c "import os,base64;print('k1:'+base64.b64encode(os.urandom(32)).decode())"
TR_ENCRYPTION_KEYS=
TR_CORS_ORIGINS=http://localhost:3000
TR_WEB_REFRESH_COOKIE_SECURE=false

# Analysis
TR_ACTIVE_URL_PROBING=false
TR_THREAT_INTEL_MOCK=true
TR_RDAP_ENABLED=false
TR_GOOGLE_SAFE_BROWSING_API_KEY=
TR_URLHAUS_AUTH_KEY=

# AI: null | mock | anthropic
TR_AI_PROVIDER=null
TR_ANTHROPIC_API_KEY=
TR_ANTHROPIC_MODEL=claude-opus-5-5

# Storage: local | s3
TR_STORAGE_BACKEND=local
TR_STORAGE_LOCAL_PATH=./var/uploads
TR_S3_ENDPOINT_URL=
TR_S3_BUCKET=
TR_S3_REGION=
